# flip-options-bot env example. NEVER commit real values.
# Place at /root/.config/flip-options-bot/.env with chmod 600, fill in paper creds.

# === Phase ===
# 'paper' or 'live'. Default paper. Live requires explicit LIVETRADE_ENABLED=true.
FOB_PHASE=paper
LIVETRADE_ENABLED=false

# === Alpaca paper credentials (REQUIRED for paper mode) ===
APCA_API_KEY_ID_PAPER=
APCA_API_SECRET_KEY_PAPER=
APCA_API_BASE_URL_PAPER=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets

# === Alpaca live credentials (leave blank for paper-only) ===
APCA_API_KEY_ID_LIVE=
APCA_API_SECRET_KEY_LIVE=
APCA_API_BASE_URL_LIVE=https://api.alpaca.markets

# === Capital & sizing ===
FOB_EQUITY_START=10000
FOB_MAX_POSITIONS=3
FOB_PER_TRADE_RISK_PCT=2.0
FOB_DAILY_LOSS_CAP_PCT=6.0
FOB_WEEKLY_LOSS_CAP_PCT=12.0
FOB_MAX_CONTRACT_DOLLAR=500

# === DTE window (0-14 long-call) ===
FOB_MIN_DTE=1
FOB_TARGET_DTE=5
FOB_MAX_DTE=14

# === Fill + scan cadence ===
FOB_SCAN_INTERVAL_S=60
FOB_LIMIT_FILL_WINDOW_S=60
FOB_RESUBMIT_COOLDOWN_S=120
FOB_MAX_QUOTE_AGE_S=15

# === Blackouts ===
FOB_AVOID_FOMC=true
FOB_AVOID_EARNINGS=true
FOB_EARNINGS_OTM_MIN_PCT=0.005

# === Trailing + profit lock ===
FOB_TRAILING_PROFIT_FLOOR_PCT=0.05
FOB_TRAILING_PEAK_GAIN_RETENTION_PCT=0.50
FOB_DAILY_PROFIT_LOCK_ARM_PCT=2.0
FOB_DAILY_PROFIT_LOCK_RETENTION_PCT=0.50

# === Strategy: long-call (default) ===
FOB_LONG_CALL_ENABLED=true
FOB_LONG_CALL_MIN_DIRECTION_MOVE_PCT=0.003
FOB_LONG_CALL_MAX_VWAP_EXTENSION_PCT=0.020
FOB_LONG_CALL_MIN_SHORT_MOMENTUM_PCT=0.0010
FOB_LONG_CALL_MIN_CONVICTION=0.45
FOB_LONG_CALL_DIRECTIONAL_LOOKBACK_MINUTES=20

# === Strategy: long-call-diagonal (off by default) ===
# Reuses the spec at runs/audits/2026-08-11-diagonal-spec.md but is OFF until
# the exit-logic revision in the spec's "Next steps" is implemented.
FOB_DIAGONAL_ENABLED=false

# === Entry window ===
FOB_ENTRY_HOURS_ET=09:30-15:30

# === Close policy ===
FOB_CLOSE_EOD_MINUTES=5

# === Dashboard ===
FOB_DASHBOARD=true
FOB_DASHBOARD_PORT=8100

# === Alerting ===
FOB_ALERT_LEVEL=normal
FOB_DISCORD_WEBHOOK=

# === Run dir (created by daemon) ===
FOB_RUN_DIR=/root/flip/projects/flip-options-bot/runs

# === Position monitor cadence ===
FOB_POSITION_MONITOR_INTERVAL_S=15